---
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#17251f" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Playfair+Display:ital,wght@0,400;0,500;1,400;1,500&display=swap');

:root {
  --ink: #17251f;
  --ink-soft: #314039;
  --paper: #f3efe7;
  --paper-light: #faf8f3;
  --sage: #899a83;
  --line: rgba(23,37,31,.18);
  --max: 1180px;
}
* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body { margin: 0; color: var(--ink); background: var(--paper-light); font-family: "DM Sans", sans-serif; }
a { color: inherit; text-decoration: none; }
.site-header { position: absolute; z-index: 10; top: 0; left: 0; width: 100%; padding: 26px 4vw; display:flex; align-items:center; justify-content:space-between; color:white; }
.brand { display:flex; align-items:center; gap:11px; font-size:11px; line-height:1.05; letter-spacing:.08em; font-weight:600; }
.brand small { font-size:8px; opacity:.65; letter-spacing:.16em; }
.brand-mark { width:30px; height:30px; border:1px solid currentColor; border-radius:50%; display:grid; place-items:center; font-family:"Playfair Display",serif; font-size:18px; font-weight:400; }
nav { display:flex; gap:30px; font-size:12px; }
nav a { opacity:.82; transition:.2s; } nav a:hover { opacity:1; }
.header-cta { border-bottom:1px solid currentColor; padding-bottom:4px; font-size:12px; }
.hero { min-height:92vh; background:var(--ink); color:white; position:relative; overflow:hidden; display:flex; align-items:flex-end; padding:150px 8vw 9vh; }
.hero::before { content:""; position:absolute; width:65vw; height:65vw; right:-25vw; top:-25vw; border:1px solid rgba(255,255,255,.12); border-radius:50%; box-shadow:0 0 0 80px rgba(255,255,255,.025),0 0 0 180px rgba(255,255,255,.02); }
.hero-glow { position:absolute; width:45vw; height:45vw; left:-20vw; bottom:-35vw; border-radius:50%; background:radial-gradient(circle, rgba(137,154,131,.28), transparent 68%); }
.hero-content { position:relative; max-width:900px; }
.kicker, .section-label { font-size:10px; letter-spacing:.18em; font-weight:600; margin:0 0 22px; }
.hero h1 { font-family:"Playfair Display",serif; font-size:clamp(64px,9.5vw,138px); line-height:.84; letter-spacing:-.045em; font-weight:400; margin:0; }
.hero h1 em { font-size:.65em; color:#aab7a5; }
.hero-subtitle { max-width:590px; font-size:16px; line-height:1.65; color:rgba(255,255,255,.76); margin:38px 0 32px; }
.button { display:inline-flex; align-items:center; justify-content:space-between; gap:35px; padding:15px 20px; border:1px solid var(--ink); font-size:11px; letter-spacing:.07em; text-transform:uppercase; transition:.25s; }
.button:hover { background:var(--ink); color:white; }
.button-light { border-color:rgba(255,255,255,.5); color:white; } .button-light:hover { background:white; color:var(--ink); }
.hero-side { position:absolute; right:5vw; bottom:9vh; display:flex; flex-direction:column; gap:15px; font-size:10px; opacity:.4; }
.section { padding:120px 8vw; max-width:1400px; margin:auto; }
.intro { display:grid; grid-template-columns:1fr 2fr; gap:7vw; }
.intro h2, .profile h2, .info h2 { font-family:"Playfair Display",serif; font-weight:400; font-size:clamp(45px,6vw,78px); line-height:.92; margin:0; letter-spacing:-.035em; }
h2 span { color:var(--sage); font-style:italic; }
.intro-copy { display:grid; grid-template-columns:1fr 1fr; gap:7vw; align-items:end; }
.intro-copy p { line-height:1.75; color:var(--ink-soft); font-size:15px; }
.events-section { padding-top:40px; }
.events-grid { display:grid; grid-template-columns:1fr 1fr; border-top:1px solid var(--line); }
.event-card { padding:34px 35px 45px; border-right:1px solid var(--line); min-height:480px; display:flex; flex-direction:column; }
.event-card:last-child { border-right:0; }
.event-top { display:flex; justify-content:space-between; align-items:center; margin-bottom:75px; }
.event-number { font-family:"Playfair Display",serif; font-size:30px; }
.event-date, .event-eyebrow { font-size:10px; letter-spacing:.15em; font-weight:600; }
.event-eyebrow { color:#71816c; margin-bottom:18px; }
.event-card h3 { font-family:"Playfair Display",serif; font-size:clamp(34px,4vw,54px); font-weight:400; line-height:.98; margin:0 0 20px; max-width:500px; }
.event-description { max-width:520px; line-height:1.65; color:var(--ink-soft); margin:0; }
.event-audience { margin-top:18px; font-size:12px; font-weight:600; }
.text-link { margin-top:auto; padding-top:40px; font-size:11px; letter-spacing:.08em; text-transform:uppercase; }
.text-link span { margin-left:12px; font-size:17px; }
.detail { padding:130px 8vw; display:grid; grid-template-columns:120px 1fr; gap:4vw; }
.detail-dark { background:var(--ink); color:white; }
.detail-paper { background:#e6e0d4; }
.detail-number { font-family:"Playfair Display",serif; font-size:28px; opacity:.45; }
.detail-content { max-width:900px; }
.detail h2 { font-family:"Playfair Display",serif; font-size:clamp(52px,7vw,92px); line-height:.9; font-weight:400; letter-spacing:-.04em; margin:0 0 35px; }
.detail h2 em { color:#9dad98; }
.detail-paper h2 em { color:#65775f; }
.lead { font-size:18px; line-height:1.65; max-width:720px; opacity:.78; }
.detail-meta { display:grid; grid-template-columns:repeat(3,1fr); gap:25px; margin-top:70px; padding-top:25px; border-top:1px solid rgba(255,255,255,.18); }
.detail-paper .detail-meta { border-color:var(--line); }
.detail-meta span { display:block; font-size:9px; letter-spacing:.15em; opacity:.55; margin-bottom:9px; }
.detail-meta strong { font-size:13px; font-weight:500; }
.profile { display:grid; grid-template-columns:1fr 1fr; gap:8vw; align-items:center; }
.profile-photo { min-height:650px; background:linear-gradient(145deg,#c8c6ba,#747f73); display:grid; place-items:end start; padding:30px; color:white; font-size:10px; letter-spacing:.15em; }
.profile-copy p { line-height:1.75; color:var(--ink-soft); max-width:560px; }
.profile-copy h2 { margin-bottom:35px; }
.quote { background:#dbe0d5; padding:120px 15vw; text-align:center; }
.quote-mark { font-family:"Playfair Display",serif; font-size:100px; line-height:.4; opacity:.25; }
blockquote { font-family:"Playfair Display",serif; font-size:clamp(28px,4vw,48px); line-height:1.2; font-weight:400; margin:30px auto; max-width:950px; }
cite { font-size:10px; letter-spacing:.08em; font-style:normal; opacity:.65; }
.info { display:grid; grid-template-columns:1fr 1fr; gap:8vw; }
.info h2 { font-size:clamp(48px,6vw,75px); }
.info-list { border-top:1px solid var(--line); }
.info-list div { display:flex; justify-content:space-between; gap:30px; padding:24px 0; border-bottom:1px solid var(--line); font-size:12px; }
.info-list span { font-size:9px; letter-spacing:.15em; opacity:.55; }
.info-list strong { font-weight:500; text-align:right; }
.register { background:var(--ink); color:white; padding:120px 8vw; text-align:center; }
.register h2 { font-family:"Playfair Display",serif; font-size:clamp(55px,8vw,100px); font-weight:400; margin:0 0 20px; }
.register p:not(.kicker) { max-width:560px; margin:0 auto 35px; line-height:1.65; color:rgba(255,255,255,.65); }
.register .button { border-color:rgba(255,255,255,.45); } .register .button:hover { background:white; color:var(--ink); }
.footer { background:#101b17; color:white; padding:40px 4vw; display:grid; grid-template-columns:1fr 1fr 1fr; gap:30px; align-items:center; font-size:10px; }
.footer p { margin:3px 0; opacity:.55; }
.footer-links { display:flex; justify-content:flex-end; gap:25px; }
.footer-links a { opacity:.7; } .footer-links a:hover { opacity:1; }

@media (max-width: 800px) {
  .site-header { padding:20px; } nav { display:none; } .header-cta { font-size:10px; }
  .hero { min-height:90vh; padding:130px 25px 55px; }
  .hero h1 { font-size:17vw; }
  .hero-subtitle { font-size:14px; }
  .section { padding:80px 25px; }
  .intro, .profile, .info { grid-template-columns:1fr; gap:45px; }
  .intro-copy { grid-template-columns:1fr; gap:10px; }
  .events-grid { grid-template-columns:1fr; }
  .event-card { border-right:0; border-bottom:1px solid var(--line); min-height:420px; padding:28px 0 40px; }
  .event-card:last-child { border-bottom:0; }
  .detail { grid-template-columns:1fr; padding:85px 25px; gap:25px; }
  .detail-meta { grid-template-columns:1fr; gap:20px; margin-top:45px; }
  .profile-photo { min-height:480px; }
  .quote { padding:85px 25px; }
  .info-list div { flex-direction:column; gap:7px; }
  .info-list strong { text-align:left; }
  .register { padding:90px 25px; }
  .footer { grid-template-columns:1fr; padding:35px 25px; }
  .footer-links { justify-content:flex-start; }
}
</style>
